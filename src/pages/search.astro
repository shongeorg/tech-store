---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, categories } from '../data/products.js';
---
<BaseLayout
  title="Пошук товарів — ТЕХНОПРОСТІР"
  description="Пошук серед електроніки та побутової техніки в магазині ТЕХНОПРОСТІР. Швидкий підбір товару за назвою, брендом або категорією."
>
  <div class="shell py-space-lg">
    <nav class="mb-space-sm flex items-center gap-1 text-body-sm text-on-surface-variant">
      <a href="/" class="hover:text-primary">Головна</a>
      <span class="material-symbols-outlined text-[16px] text-slate-400">chevron_right</span>
      <span class="font-medium text-on-surface">Пошук</span>
    </nav>

    <div class="mb-space-md flex flex-wrap items-end justify-between gap-space-md">
      <div>
        <h1 class="text-headline-xl tracking-tight">
          Пошук: <span class="text-blue-600" data-search-q>всі товари</span>
        </h1>
        <p class="mt-1 text-body-md text-on-surface-variant">
          Знайдено <b class="tabular text-on-surface" data-search-count>{products.length}</b> товарів
          <span data-search-cat-label class="hidden"></span>
        </p>
      </div>
      <div class="relative w-full max-w-md">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-slate-400">search</span>
        <form action="/search" method="get" class="flex">
          <input type="search" name="q" data-search-input placeholder="Уточніть запит…" class="input h-11 pl-10 text-body-md" />
          <button type="submit" class="btn-primary ml-2 px-space-lg text-body-md">Знайти</button>
        </form>
      </div>
    </div>

    <!-- Підказка: категорії -->
    <div class="mb-space-md flex flex-wrap gap-space-xs" data-search-suggestions>
      <span class="py-1 text-body-sm text-outline">Популярні категорії:</span>
      {categories.slice(0, 6).map((c) => (
        <a href={`/catalog/${c.slug}`} class="chip">{c.name}</a>
      ))}
    </div>

    <div class="grid grid-cols-1 gap-space-md sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-search-grid>
      {products.map((p) => <ProductCard product={p} variant="grid" />)}
    </div>

    <!-- Empty state -->
    <div class="card hidden flex-col items-center gap-space-md p-space-2xl text-center" data-search-empty style="display:none">
      <span class="material-symbols-outlined text-5xl text-slate-300">search_off</span>
      <p class="text-headline-md">За вашим запитом нічого не знайдено</p>
      <p class="max-w-md text-body-md text-on-surface-variant">
        Спробуйте змінити пошуковий запит, переглянути категорії або очистити фільтри.
      </p>
      <div class="flex flex-wrap justify-center gap-space-sm">
        <a href="/catalog" class="btn-primary px-space-lg py-2.5 text-body-md">Переглянути категорії</a>
        <a href="/search" class="btn-outline px-space-lg py-2.5 text-body-md">Очистити пошук</a>
      </div>
    </div>
  </div>

  <script>
    import { categories } from '../data/products.js';

    const params = new URLSearchParams(window.location.search);
    const q = (params.get('q') ?? '').trim().toLowerCase();
    const cat = params.get('cat') ?? '';

    const qLabel = document.querySelector('[data-search-q]');
    const countEl = document.querySelector('[data-search-count]');
    const catLabel = document.querySelector('[data-search-cat-label]');
    const input = document.querySelector('[data-search-input]');
    const cards = Array.from(document.querySelectorAll('[data-search-grid] [data-product-card]'));
    const empty = document.querySelector('[data-search-empty]');

    if (input instanceof HTMLInputElement && q) input.value = q;
    if (qLabel) qLabel.textContent = q || 'всі товари';

    const catName = cat ? (categories.find((c) => c.slug === cat)?.name ?? '') : '';
    if (catLabel && catName) {
      catLabel.classList.remove('hidden');
      catLabel.textContent = ` у категорії «${catName}»`;
    }

    let shown = 0;
    for (const card of cards) {
      const haystack = card.dataset.search ?? '';
      const matchesQ = !q || haystack.includes(q);
      const matchesCat = !cat || card.dataset.category === cat;
      const visible = matchesQ && matchesCat;
      card.classList.toggle('hidden', !visible);
      if (visible) shown += 1;
    }
    if (countEl) countEl.textContent = String(shown);
    if (empty instanceof HTMLElement) {
      empty.classList.toggle('hidden', shown !== 0);
      empty.style.display = shown === 0 ? 'flex' : '';
    }
  </script>
</BaseLayout>
