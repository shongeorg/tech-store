---
// Каталог/категорія: breadcrumbs, фільтри-сайдбар (Stitch: _3 desktop, _6 mobile drawer),
// сортування, сітка товарів. Товари тягнуться клієнтом з Laravel API (/api/v1/products),
// фільтрування теж відбувається в API: brands[], stock, price_min/max, memory[], sort, page.
const {
  products,
  title,
  description = '',
  crumbs = [],
  showTradeIn = false,
  categorySlug = '',
} = Astro.props;

const prices = products.map((p) => p.price);
const priceMin = Math.floor(Math.min(...prices) / 1000) * 1000;
const priceMax = Math.ceil(Math.max(...prices) / 1000) * 1000;

const brandCounts = new Map();
for (const p of products) brandCounts.set(p.brand, (brandCounts.get(p.brand) ?? 0) + 1);
const brandsList = [...brandCounts.entries()].sort((a, b) => b[1] - a[1]);
const chipBrands = brandsList.slice(0, 7).map(([b]) => b);

const memOptions = ['128 ГБ', '256 ГБ', '512 ГБ', '1 ТБ'].filter((m) =>
  products.some((p) => p.memory?.includes(m)),
);

const sortOptions = [
  ['pop', 'За популярністю'],
  ['rating', 'За рейтингом'],
  ['price-asc', 'Від дешевих до дорогих'],
  ['price-desc', 'Від дорогих до дешевих'],
  ['new', 'Спочатку новинки'],
  ['discount', 'За розміром знижки'],
];
---

<div data-catalog-root data-category-slug={categorySlug}>
  <!-- Breadcrumbs -->
  <nav class="shell flex items-center gap-1 py-space-sm text-body-sm text-on-surface-variant" aria-label="Хлібні крихти">
    {crumbs.map((c, i) => (
      <>
        {i > 0 && <span class="material-symbols-outlined text-[16px] text-slate-400">chevron_right</span>}
        {c.href ? <a href={c.href} class="hover:text-primary">{c.label}</a> : <span class="font-medium text-on-surface">{c.label}</span>}
      </>
    ))}
  </nav>

  <div class="shell pb-space-2xl">
    <!-- Заголовок -->
    <div class="mb-space-md flex flex-wrap items-end justify-between gap-space-md">
      <div>
        <h1 class="text-headline-xl tracking-tight text-on-surface">
          {title}
          <span class="ml-2 text-body-md font-normal text-outline" data-api-total-inline>товарів з API</span>
        </h1>
        {description && <p class="mt-1 max-w-4xl text-body-md text-on-surface-variant">{description}</p>}
      </div>
      <p class="flex items-center gap-2 text-body-sm text-on-surface-variant">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        Склад у Києві: 94% наявність
        <span class="text-outline">• Оновлено: сьогодні о 09:30</span>
      </p>
    </div>

    <!-- Чіпи брендів -->
    {chipBrands.length > 1 && (
      <div class="mb-space-md flex flex-wrap gap-space-sm">
        <button type="button" class="chip is-active" data-chip-all>Усі</button>
        {chipBrands.map((b) => (
          <button type="button" class="chip" data-chip-brand={b}>
            {b}
            <span class="tabular opacity-70">{brandCounts.get(b)}</span>
          </button>
        ))}
      </div>
    )}

    <div class="flex gap-space-xl">
      <!-- ================= ФІЛЬТРИ ================= -->
      <aside class="filters-panel" data-filters-panel aria-label="Фільтри">
        <div class="card p-space-md">
          <div class="mb-space-md flex items-center justify-between">
            <h2 class="flex items-center gap-2 text-headline-sm">
              Фільтри
              <span class="hidden rounded-full bg-blue-600 px-2 text-[11px] font-bold text-white" data-filter-count>0</span>
            </h2>
            <button type="button" class="flex items-center gap-1 text-body-sm text-blue-600 hover:underline" data-reset-filters>
              Скинути всі
            </button>
            <button type="button" class="lg:hidden" data-close-filters aria-label="Закрити">
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>

          <div class="flex flex-col gap-space-xl">
            <!-- Ціна -->
            <section>
              <h3 class="mb-space-sm flex items-center justify-between text-body-md font-bold">
                <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-blue-600">payments</span>Ціна, ₴</span>
                <span class="material-symbols-outlined text-[18px] text-slate-400">expand_less</span>
              </h3>
              <div class="mb-space-sm flex items-center gap-space-sm">
                <input type="number" class="input py-2 text-body-sm" placeholder="Від" value={priceMin} min={priceMin} max={priceMax} data-price-min-input />
                <input type="number" class="input py-2 text-body-sm" placeholder="До" value={priceMax} min={priceMin} max={priceMax} data-price-max-input />
              </div>
              <div class="tp-range" data-range>
                <div class="tp-range-track"></div>
                <div class="tp-range-fill" data-range-fill></div>
                <input type="range" min={priceMin} max={priceMax} step={1000} value={priceMin} data-range-min aria-label="Ціна від" />
                <input type="range" min={priceMin} max={priceMax} step={1000} value={priceMax} data-range-max aria-label="Ціна до" />
              </div>
              <div class="mt-1 flex justify-between text-specs-mono text-slate-500">
                <span>мін: {new Intl.NumberFormat('uk-UA').format(priceMin)} ₴</span>
                <span>макс: {new Intl.NumberFormat('uk-UA').format(priceMax)} ₴</span>
              </div>
            </section>

            <!-- Наявність -->
            <section>
              <h3 class="mb-space-sm flex items-center justify-between text-body-md font-bold">
                <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-blue-600">inventory_2</span>Наявність та доставка</span>
                <span class="material-symbols-outlined text-[18px] text-slate-400">expand_less</span>
              </h3>
              <label class="mb-2 flex cursor-pointer items-center justify-between rounded-md px-2 py-1.5 hover:bg-slate-50">
                <span class="flex items-center gap-2 text-body-md">
                  <input type="checkbox" class="h-4.5 w-4.5 accent-blue-600" data-filter-stock />
                  Тільки в наявності
                </span>
                <span class="tabular text-specs-mono text-slate-500">{products.filter((p) => p.stock === 'in').length}</span>
              </label>
              <label class="flex cursor-pointer items-center justify-between rounded-md px-2 py-1.5 hover:bg-slate-50">
                <span class="flex items-center gap-2 text-body-md">
                  <input type="checkbox" class="h-4.5 w-4.5 accent-blue-600" data-filter-preorder />
                  Передзамовлення
                </span>
                <span class="tabular text-specs-mono text-slate-500">{products.filter((p) => p.stock === 'order').length}</span>
              </label>
            </section>

            <!-- Бренд -->
            <section>
              <h3 class="mb-space-sm flex items-center justify-between text-body-md font-bold">
                <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-blue-600">sell</span>Бренд</span>
                <span class="material-symbols-outlined text-[18px] text-slate-400">expand_less</span>
              </h3>
              <div class="relative mb-space-sm">
                <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-[16px] text-slate-400">search</span>
                <input type="search" placeholder="Пошук бренду…" class="input py-2 pl-8 text-body-sm" data-brand-search />
              </div>
              <div class="flex max-h-56 flex-col gap-0.5 overflow-y-auto" data-brand-list>
                {brandsList.map(([b, count]) => (
                  <label class="flex cursor-pointer items-center justify-between rounded-md px-2 py-1.5 hover:bg-slate-50" data-brand-row={b.toLowerCase()}>
                    <span class="flex items-center gap-2 text-body-md">
                      <input type="checkbox" class="h-4.5 w-4.5 accent-blue-600" value={b} data-filter-brand />
                      {b}
                    </span>
                    <span class="tabular text-specs-mono text-slate-500">{count}</span>
                  </label>
                ))}
              </div>
            </section>

            <!-- Вбудована пам'ять -->
            {memOptions.length > 0 && (
              <section>
                <h3 class="mb-space-sm flex items-center justify-between text-body-md font-bold">
                  <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-blue-600">sd_card</span>Вбудована пам'ять</span>
                  <span class="material-symbols-outlined text-[18px] text-slate-400">expand_less</span>
                </h3>
                <div class="flex flex-wrap gap-space-xs">
                  {memOptions.map((m) => (
                    <button type="button" class="chip" data-filter-mem={m}>{m}</button>
                  ))}
                </div>
              </section>
            )}

            {showTradeIn && (
              <section class="rounded-lg bg-blue-600 p-space-md text-white">
                <span class="badge mb-2 inline-flex bg-orange-500 text-white">ВИГОДА ДО 70%</span>
                <p class="text-headline-sm font-bold">Обміняйте старий телефон на новий iPhone 16</p>
                <p class="mt-1 text-body-sm text-blue-100">Оцініть онлайн за 2 хвилини або в будь-якому магазині «Технопростір».</p>
                <a href="#" class="mt-space-sm inline-block text-body-sm font-semibold underline">Розрахувати вартість →</a>
              </section>
            )}

            <button type="button" class="btn-primary w-full py-3 text-body-md lg:hidden" data-apply-count data-close-filters>
              Показати <span data-shown-count>…</span> товарів
            </button>
          </div>
        </div>
      </aside>

      <!-- ================= ТОВАРИ ================= -->
      <div class="min-w-0 flex-1">
        <!-- Панель сортування -->
        <div class="card mb-space-md flex flex-wrap items-center gap-space-md px-space-md py-space-sm">
          <button type="button" class="flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-body-sm font-semibold text-blue-700 lg:hidden" data-open-filters>
            <span class="material-symbols-outlined text-[18px]">tune</span>
            Фільтри
            <span class="hidden rounded-full bg-blue-600 px-2 text-[11px] font-bold text-white" data-filter-count>0</span>
          </button>
          <label class="flex items-center gap-space-sm text-body-sm">
            <span class="text-on-surface-variant">Сортування:</span>
            <select class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-body-sm font-medium focus:border-blue-600 focus:outline-none" data-sort-select>
              {sortOptions.map(([v, label]) => <option value={v}>{label}</option>)}
            </select>
          </label>
          <p class="text-body-sm text-on-surface-variant">
            Показано <span class="tabular font-semibold text-on-surface" data-shown-count>…</span> із <span class="tabular" data-total-count>…</span> товарів з API
          </p>
          <div class="ml-auto hidden items-center gap-1 md:flex">
            <button type="button" class="grid h-8 w-8 place-items-center rounded-md bg-blue-600 text-white" aria-label="Сітка">
              <span class="material-symbols-outlined text-[18px]">grid_view</span>
            </button>
            <button type="button" class="grid h-8 w-8 place-items-center rounded-md border border-slate-300 text-slate-500" aria-label="Список">
              <span class="material-symbols-outlined text-[18px]">view_list</span>
            </button>
          </div>
        </div>

        <!-- Активні фільтри -->
        <div class="mb-space-md flex flex-wrap items-center gap-space-sm" data-active-chips hidden>
          <span class="text-caption font-bold uppercase tracking-wide text-outline">Фільтри:</span>
          <span class="flex flex-wrap items-center gap-space-sm" data-active-chips-list></span>
          <button type="button" class="text-body-sm font-semibold text-blue-600 hover:underline" data-reset-filters>Очистити всі</button>
        </div>

        <!-- Сітка (товари тягнуться з Laravel API; до відповіді — скелетони) -->
        <div
          class="grid grid-cols-1 gap-space-md sm:grid-cols-2 xl:grid-cols-3"
          data-product-grid
        >
          {Array.from({ length: 6 }).map(() => (
            <div class="card flex flex-col gap-space-sm overflow-hidden p-0">
              <div class="skeleton aspect-square w-full"></div>
              <div class="flex flex-col gap-space-sm p-space-md">
                <div class="skeleton h-4 w-1/3"></div>
                <div class="skeleton h-5 w-3/4"></div>
                <div class="skeleton h-7 w-2/5"></div>
              </div>
            </div>
          ))}
        </div>

        <!-- Помилка API -->
        <div class="card hidden flex-col items-center gap-space-md p-space-2xl text-center" data-api-error>
          <span class="material-symbols-outlined text-5xl text-red-300">cloud_off</span>
          <p class="text-headline-md">API недоступний</p>
          <p class="max-w-md text-body-md text-on-surface-variant">
            Не вдалося завантажити товари з Laravel API. Перевірте, що сервер піднято, і спробуйте ще раз.
          </p>
          <button type="button" class="btn-primary px-6 py-2.5 text-body-md" data-api-retry>Спробувати ще раз</button>
        </div>

        <!-- Порожній стан -->
        <div class="card hidden flex-col items-center gap-space-md p-space-2xl text-center" data-empty-state>
          <span class="material-symbols-outlined text-5xl text-slate-300">search_off</span>
          <p class="text-headline-md">Товарів не знайдено</p>
          <p class="max-w-md text-body-md text-on-surface-variant">
            Спробуйте змінити пошуковий запит або очистити фільтри, щоб побачити більше результатів.
          </p>
          <button type="button" class="btn-primary px-6 py-2.5 text-body-md" data-reset-filters>Очистити фільтри</button>
        </div>

        <!-- Пагінація поверх API -->
        <div class="mt-space-xl flex flex-col items-center gap-space-md" data-pagination>
          <p class="text-body-sm text-on-surface-variant">
            Сторінка <span class="tabular font-semibold text-on-surface" data-page-current>1</span>
            із <span class="tabular" data-page-total>1</span>
            (<span class="tabular" data-total-count>0</span> товарів у API)
          </p>
          <div class="flex items-center gap-space-xs">
            <button type="button" class="grid h-9 w-9 place-items-center rounded-md border border-slate-300 text-slate-400" data-page-prev disabled>
              <span class="material-symbols-outlined text-[18px]">chevron_left</span>
            </button>
            <button type="button" class="grid h-9 w-9 place-items-center rounded-md border border-slate-300 text-slate-600 hover:border-blue-400" data-page-next>
              <span class="material-symbols-outlined text-[18px]">chevron_right</span>
            </button>
          </div>
        </div>

        <!-- Переваги після каталогу -->
        <div class="mt-space-xl grid grid-cols-1 gap-space-md md:grid-cols-3">
          <div class="card flex items-start gap-space-sm p-space-md">
            <span class="material-symbols-outlined text-[22px] text-blue-600">verified</span>
            <div>
              <p class="text-body-md font-bold">100% Офіційна техніка</p>
              <p class="text-body-sm text-on-surface-variant">Всі товари з гарантійним талоном виробника та сервісною підтримкою в Україні.</p>
            </div>
          </div>
          <div class="card flex items-start gap-space-sm p-space-md">
            <span class="material-symbols-outlined text-[22px] text-emerald-600">credit_card</span>
            <div>
              <p class="text-body-md font-bold">Оплата частинами 0%</p>
              <p class="text-body-sm text-on-surface-variant">До 24 платежів від ПриватБанку, monobank та А-Банку без переплат.</p>
            </div>
          </div>
          <div class="card flex items-start gap-space-sm p-space-md">
            <span class="material-symbols-outlined text-[22px] text-orange-600">autorenew</span>
            <div>
              <p class="text-body-md font-bold">Легкий обмін 14 днів</p>
              <p class="text-body-sm text-on-surface-variant">Міняйте відкритий товар або поверніть пристрій без зайвих бюрократій.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    apiGet,
    cardHtml,
    qs,
    ensureApiStyles,
    type ApiProduct,
    type Paginated,
  } from '../lib/api';

  ensureApiStyles();

  function initCatalog(root: HTMLElement): void {
    const grid = root.querySelector('[data-product-grid]') as HTMLElement | null;
    if (grid === null) return;

    const categorySlug = root.dataset.categorySlug ?? '';
    const perPage = 12;

    const panel = root.querySelector('[data-filters-panel]');
    const brandChecks = Array.from(root.querySelectorAll<HTMLInputElement>('[data-filter-brand]'));
    const stockOnly = root.querySelector<HTMLInputElement>('[data-filter-stock]');
    const preorderEl = root.querySelector<HTMLInputElement>('[data-filter-preorder]');
    const memButtons = Array.from(root.querySelectorAll<HTMLElement>('[data-filter-mem]'));
    const chipAll = root.querySelector('[data-chip-all]');
    const chipBrands = Array.from(root.querySelectorAll<HTMLElement>('[data-chip-brand]'));
    const minInput = root.querySelector<HTMLInputElement>('[data-price-min-input]');
    const maxInput = root.querySelector<HTMLInputElement>('[data-price-max-input]');
    const rangeMin = root.querySelector<HTMLInputElement>('[data-range-min]');
    const rangeMax = root.querySelector<HTMLInputElement>('[data-range-max]');
    const rangeFill = root.querySelector<HTMLElement>('[data-range-fill]');
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort-select]');
    const brandSearch = root.querySelector<HTMLInputElement>('[data-brand-search]');
    const activeChips = root.querySelector('[data-active-chips]');
    const activeList = root.querySelector('[data-active-chips-list]');
    const emptyState = root.querySelector('[data-empty-state]');
    const apiError = root.querySelector('[data-api-error]');
    const retryBtn = root.querySelector('[data-api-retry]');
    const pagination = root.querySelector('[data-pagination]');
    const pageCurrent = root.querySelector('[data-page-current]');
    const pageTotal = root.querySelector('[data-page-total]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-page-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-page-next]');
    const shownCounts = Array.from(root.querySelectorAll<HTMLElement>('[data-shown-count]'));
    const totalCounts = Array.from(root.querySelectorAll<HTMLElement>('[data-total-count]'));
    const totalInline = root.querySelector('[data-api-total-inline]');
    const filterCounts = Array.from(root.querySelectorAll<HTMLElement>('[data-filter-count]'));

    // Межі ціни — з серверно відрендерених інпутів (meta з каталогу).
    const pMin = Number(minInput?.min ?? 1000);
    const pMax = Number(maxInput?.max ?? 100000);

    const state = {
      brands: new Set<string>(),
      mem: new Set<string>(),
      stock: false,
      preorder: false,
      min: pMin,
      max: pMax,
      sort: 'pop',
      page: 1,
    };

    let loading = false;
    let debounce: number | undefined;

    const fmt = (n: number): string => new Intl.NumberFormat('uk-UA').format(n);

    function skeletonGrid(): void {
      grid.innerHTML = Array.from(
        { length: 6 },
        () => `
        <div class="card flex flex-col gap-space-sm overflow-hidden p-0">
          <div class="skeleton aspect-square w-full"></div>
          <div class="flex flex-col gap-space-sm p-space-md">
            <div class="skeleton h-4 w-1/3"></div>
            <div class="skeleton h-5 w-3/4"></div>
            <div class="skeleton h-7 w-2/5"></div>
          </div>
        </div>`,
      ).join('');
    }

    function scheduleApply(): void {
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => void apply(), 300);
    }

    async function apply(): Promise<void> {
      if (loading || grid === null) return;
      loading = true;
      skeletonGrid();
      apiError?.classList.add('hidden');

      const params = {
        category: categorySlug === '' ? undefined : categorySlug,
        brands: [...state.brands],
        memory: [...state.mem],
        stock: state.stock && state.preorder ? '' : state.stock ? 'in' : state.preorder ? 'order' : '',
        price_min: state.min > pMin ? state.min : undefined,
        price_max: state.max < pMax ? state.max : undefined,
        sort: state.sort,
        page: state.page,
        per_page: perPage,
      };

      try {
        const res = await apiGet<Paginated<ApiProduct>>(`/products${qs(params)}`);
        grid.innerHTML =
          res.data.length === 0 ? '' : res.data.map((p) => cardHtml(p, 'grid')).join('');

        shownCounts.forEach((el) => (el.textContent = String(res.data.length)));
        totalCounts.forEach((el) => (el.textContent = String(res.meta.total)));
        if (totalInline) totalInline.textContent = `${fmt(res.meta.total)} товарів з API`;

        if (pageCurrent) pageCurrent.textContent = String(res.meta.current_page);
        if (pageTotal) pageTotal.textContent = String(res.meta.last_page);
        if (prevBtn) prevBtn.disabled = res.meta.current_page <= 1;
        if (nextBtn) nextBtn.disabled = res.meta.current_page >= res.meta.last_page;

        if (emptyState) {
          emptyState.classList.toggle('hidden', res.data.length !== 0);
          emptyState.style.display = res.data.length === 0 ? 'flex' : '';
        }
        if (pagination) {
          pagination.classList.toggle('hidden', res.meta.total === 0);
          pagination.style.display = res.meta.total === 0 ? 'none' : '';
        }
      } catch {
        if (grid !== null) grid.innerHTML = '';
        if (pagination) pagination.classList.add('hidden');
        apiError?.classList.remove('hidden');
      } finally {
        loading = false;
      }

      const fCount = activeFilterCount();
      filterCounts.forEach((el) => {
        el.textContent = String(fCount);
        el.classList.toggle('hidden', fCount === 0);
      });
      chipAll?.classList.toggle('is-active', state.brands.size === 0);
      chipBrands.forEach((c) => c.classList.toggle('is-active', state.brands.has(c.dataset.chipBrand ?? '')));
      memButtons.forEach((b) => b.classList.toggle('is-active', state.mem.has(b.dataset.filterMem ?? '')));
      renderActiveChips();
      syncRangeVisual();
    }

    function syncRangeVisual(): void {
      const span = pMax - pMin || 1;
      const left = ((state.min - pMin) / span) * 100;
      const right = ((state.max - pMin) / span) * 100;
      if (rangeFill) {
        rangeFill.style.left = left + '%';
        rangeFill.style.width = Math.max(0, right - left) + '%';
      }
      if (minInput) minInput.value = String(state.min);
      if (maxInput) maxInput.value = String(state.max);
      if (rangeMin) rangeMin.value = String(state.min);
      if (rangeMax) rangeMax.value = String(state.max);
    }

    function activeFilterCount(): number {
      return (
        state.brands.size +
        state.mem.size +
        (state.stock ? 1 : 0) +
        (state.preorder ? 1 : 0) +
        (state.min > pMin || state.max < pMax ? 1 : 0)
      );
    }

    function renderActiveChips(): void {
      if (activeChips === null || activeList === null) return;
      const items: Array<{ type: string; value: string; label: string }> = [];
      state.brands.forEach((b) => items.push({ type: 'brand', value: b, label: b }));
      state.mem.forEach((m) => items.push({ type: 'mem', value: m, label: m }));
      if (state.min > pMin || state.max < pMax) {
        items.push({ type: 'price', value: '', label: `${fmt(state.min)} – ${fmt(state.max)} ₴` });
      }
      if (state.stock) items.push({ type: 'stock', value: '', label: 'В наявності' });
      if (state.preorder) items.push({ type: 'preorder', value: '', label: 'Передзамовлення' });

      activeChips.hidden = items.length === 0;
      activeList.innerHTML = '';
      for (const it of items) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chip is-active';
        btn.innerHTML = `${it.label} <span class="material-symbols-outlined text-[14px]">close</span>`;
        btn.addEventListener('click', () => {
          if (it.type === 'brand') toggleBrand(it.value, false);
          if (it.type === 'mem') toggleMem(it.value, false);
          if (it.type === 'price') {
            state.min = pMin;
            state.max = pMax;
          }
          if (it.type === 'stock') {
            state.stock = false;
            if (stockOnly) stockOnly.checked = false;
          }
          if (it.type === 'preorder') {
            state.preorder = false;
            if (preorderEl) preorderEl.checked = false;
          }
          void apply();
        });
        activeList.appendChild(btn);
      }
    }

    function toggleBrand(brand: string, on?: boolean): void {
      if (on === undefined) on = !state.brands.has(brand);
      state.page = 1;
      if (on) state.brands.add(brand);
      else state.brands.delete(brand);
      const check = brandChecks.find((c) => c.value === brand);
      if (check) check.checked = state.brands.has(brand);
    }

    function toggleMem(mem: string, on?: boolean): void {
      if (on === undefined) on = !state.mem.has(mem);
      state.page = 1;
      if (on) state.mem.add(mem);
      else state.mem.delete(mem);
    }

    function resetAll(): void {
      state.brands.clear();
      state.mem.clear();
      state.stock = false;
      state.preorder = false;
      state.min = pMin;
      state.max = pMax;
      state.page = 1;
      brandChecks.forEach((c) => (c.checked = false));
      memButtons.forEach((b) => b.classList.remove('is-active'));
      if (stockOnly) stockOnly.checked = false;
      if (preorderEl) preorderEl.checked = false;
      void apply();
    }

    // --- Події ---
    brandChecks.forEach((c) =>
      c.addEventListener('change', () => {
        toggleBrand(c.value, c.checked);
        void apply();
      }),
    );
    stockOnly?.addEventListener('change', () => {
      state.stock = stockOnly.checked;
      state.page = 1;
      void apply();
    });
    preorderEl?.addEventListener('change', () => {
      state.preorder = preorderEl.checked;
      state.page = 1;
      void apply();
    });
    memButtons.forEach((b) =>
      b.addEventListener('click', () => {
        toggleMem(b.dataset.filterMem ?? '');
        void apply();
      }),
    );
    chipBrands.forEach((c) =>
      c.addEventListener('click', () => {
        toggleBrand(c.dataset.chipBrand ?? '');
        void apply();
      }),
    );
    chipAll?.addEventListener('click', () => {
      state.brands.clear();
      state.page = 1;
      brandChecks.forEach((c) => (c.checked = false));
      void apply();
    });

    const clamp = (v: number): number => Math.min(pMax, Math.max(pMin, v));
    minInput?.addEventListener('input', () => {
      state.min = clamp(Number(minInput.value) || pMin);
      if (state.min > state.max) state.max = state.min;
      scheduleApply();
    });
    maxInput?.addEventListener('input', () => {
      state.max = clamp(Number(maxInput.value) || pMax);
      if (state.max < state.min) state.min = state.max;
      scheduleApply();
    });
    rangeMin?.addEventListener('input', () => {
      state.min = Math.min(Number(rangeMin.value), state.max);
      scheduleApply();
    });
    rangeMax?.addEventListener('input', () => {
      state.max = Math.max(Number(rangeMax.value), state.min);
      scheduleApply();
    });

    sortSelect?.addEventListener('change', () => {
      state.sort = sortSelect.value;
      state.page = 1;
      void apply();
    });

    brandSearch?.addEventListener('input', () => {
      const q = brandSearch.value.trim().toLowerCase();
      root.querySelectorAll('[data-brand-row]').forEach((row) => {
        row.classList.toggle('hidden', q !== '' && !(row.dataset.brandRow ?? '').includes(q));
      });
    });

    root.querySelectorAll('[data-reset-filters]').forEach((b) => b.addEventListener('click', resetAll));
    retryBtn?.addEventListener('click', () => void apply());

    prevBtn?.addEventListener('click', () => {
      if (state.page <= 1) return;
      state.page -= 1;
      void apply();
      window.scrollTo({ top: root.offsetTop, behavior: 'smooth' });
    });
    nextBtn?.addEventListener('click', () => {
      state.page += 1;
      void apply();
      window.scrollTo({ top: root.offsetTop, behavior: 'smooth' });
    });

    // Mobile drawer
    const openBtn = root.querySelector('[data-open-filters]');
    const closeBtns = root.querySelectorAll('[data-close-filters]');
    openBtn?.addEventListener('click', () => panel?.classList.add('is-open'));
    closeBtns.forEach((b) => b.addEventListener('click', () => panel?.classList.remove('is-open')));

    void apply();
  }

  document.querySelectorAll<HTMLElement>('[data-catalog-root]').forEach(initCatalog);
</script>

<style is:global>
  .skeleton {
    display: inline-block;
    border-radius: 6px;
    background: linear-gradient(90deg, #eef1f6 25%, #f6f8fb 50%, #eef1f6 75%);
    background-size: 200% 100%;
    animation: tp-skeleton 1.2s ease-in-out infinite;
  }
  @keyframes tp-skeleton {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }
</style>
